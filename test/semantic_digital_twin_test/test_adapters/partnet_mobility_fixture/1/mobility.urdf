<?xml version="1.0"?>
<robot name="synthetic_storage_furniture">
  <link name="base"/>
  <link name="link_1">
    <visual>
      <geometry><box size="1 1 1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="1 1 1"/></geometry>
    </collision>
  </link>
  <link name="link_0">
    <visual>
      <geometry><box size="0.1 0.5 0.5"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.1 0.5 0.5"/></geometry>
    </collision>
  </link>
  <joint name="joint_1" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="link_1"/>
  </joint>
  <joint name="joint_0" type="revolute">
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child link="link_0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57"/>
  </joint>
</robot>
